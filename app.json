{
  "expo": {
    "name": "TGCC Line-up",
    "slug": "tgcc-lineup",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "splash": { "backgroundColor": "#0d0f14" },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.tgcc.lineup",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Upload your profile photo.",
        "NSCameraUsageDescription": "Take a profile photo."
      }
    },
    "android": {
      "package": "com.tgcc.lineup",
      "adaptiveIcon": { "backgroundColor": "#0d0f14" },
      "permissions": ["READ_EXTERNAL_STORAGE", "WRITE_EXTERNAL_STORAGE"]
    },
    "plugins": ["expo-image-picker"],
    "newArchEnabled": false
  }
}
